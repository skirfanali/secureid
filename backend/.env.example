# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values for local use.
# Never commit the real .env file.
#
# For Vercel deployment, do NOT upload this file — instead add these same
# variable names as real values under:
#   Vercel Dashboard → Project → Settings → Environment Variables

PORT=4001

# Only relevant for genuinely cross-origin setups (frontend hosted
# separately from the backend). Not needed for the single-Vercel-project
# deployment, where frontend and API share one domain and are treated as
# same-origin automatically.
FRONTEND_URL=http://localhost:5173

# Long random strings in real deployments (e.g. `openssl rand -hex 32`)
SESSION_SECRET=dsfgiguifuufjbkbfebjkfewueuhofewebjkfweuhg
JWT_SECRET=yoewfiowefubhbwefbhkfwqugefuhuqwkwugfewufewuwef

# Lifetimes
SESSION_TTL_MINUTES=60
JWT_TTL_MINUTES=15

# OTP behaviour
OTP_LENGTH=6
OTP_TTL_SECONDS=165
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=25

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Use "development" locally. Set this to "production" in Vercel's
# environment variables — it switches session cookies to
# Secure + SameSite=None (required over HTTPS) and hard-disables
# DEBUG_EXPOSE_OTP below no matter what it's set to.
NODE_ENV=development

# Local/demo convenience ONLY: when true, OTP codes are also included in the
# API response (in addition to the simulated console log), so the frontend
# can display them directly instead of you checking server logs. Requires
# NODE_ENV to NOT be "production" as well — it's ignored otherwise, so it
# can never accidentally leak in a real deployment. Leave this off (or unset)
# in Vercel's environment variables.
DEBUG_EXPOSE_OTP=false
